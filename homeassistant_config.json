{
  "device": {
    "identifiers": "waterlevel_01",
    "name": "Waterlevel Sensor 01"
  },
  "origin": {
    "name": "rpi-pico-waterlevel-sensor",
    "sw_version": "1.0",
    "support_url": "https://github.com/moritzmhmk/rpi-pico-waterlevel-sensor"
  },
  "components": {
    "distance": {
      "platform": "sensor",
      "device_class": "distance",
      "unit_of_measurement": "cm",
      "value_template": "{{ value_json.distance}}",
      "unique_id": "waterlevel_01_distance"
    },
    "temperature": {
      "platform": "sensor",
      "device_class": "temperature",
      "unit_of_measurement": "°C",
      "value_template": "{{ value_json.temperature}}",
      "unique_id": "waterlevel_01_temperature"
    },
    "humidity": {
      "platform": "sensor",
      "device_class": "humidity",
      "unit_of_measurement": "%",
      "suggested_display_precision": 0,
      "value_template": "{{ value_json.humidity}}",
      "unique_id": "waterlevel_01_humidity"
    },
    "pressure": {
      "platform": "sensor",
      "device_class": "atmospheric_pressure",
      "unit_of_measurement": "Pa",
      "value_template": "{{ value_json.pressure}}",
      "unique_id": "waterlevel_01_pressure"
    },
    "batteryVoltage": {
      "platform": "sensor",
      "device_class": "voltage",
      "unit_of_measurement": "V",
      "suggested_display_precision": 2,
      "value_template": "{{ value_json.batteryVoltage}}",
      "unique_id": "waterlevel_01_battery_voltage"
    }
  },
  "state_topic": "sensor/waterlevel_01/state"
}
